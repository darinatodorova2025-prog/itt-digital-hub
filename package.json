{
  "name": "itt-digital-hub",
  "version": "0.1.0",
  "private": true,
  "description": "ITT Digital Hub: process optimization and software systems.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p platform/gateway/tsconfig.json",
    "test": "vitest run",
    "agent-hub:dev": "tsx platform/agent-hub/src/main.ts",
    "agent-hub:start": "NODE_ENV=production tsx platform/agent-hub/src/main.ts",
    "agent-gateway:dev": "wrangler dev --config platform/gateway/wrangler.jsonc --var AGENT_HUB_ORIGIN:http://127.0.0.1:8788 --var GATEWAY_ENV:development",
    "agent-gateway:types": "wrangler types platform/gateway/worker-configuration.d.ts --config platform/gateway/wrangler.jsonc --include-runtime false",
    "agent-gateway:deploy": "wrangler deploy --config platform/gateway/wrangler.jsonc",
    "agent-platform:test": "vitest run tests/agent-platform",
    "vik-mcp": "tsx src/vik-proektant/mcp-cli.ts",
    "vik-proektant:audit": "tsx scripts/vik-proektant-audit.ts",
    "ai-act:eval": "tsx scripts/ai-act-model-eval.ts",
    "seed": "tsx scripts/seed-cms.ts",
    "build:registry": "tsx scripts/build-settlement-registry.ts",
    "build:packs": "tsx scripts/build-settlement-packs.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "@turf/turf": "^7.4.0",
    "@vercel/analytics": "^2.0.1",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "osmtogeojson": "^3.0.0-beta.5",
    "posthog-js": "^1.438.7",
    "posthog-node": "^5.55.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet-draw": "^1.0.13",
    "@types/node": "22.20.4",
    "@types/osmtogeojson": "^2.2.34",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.136.1"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13"
  }
}
