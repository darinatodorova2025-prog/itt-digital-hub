# Production canonical origin is https://ittdigitalhub.org (set on Vercel production).
NEXT_PUBLIC_SITE_URL=
# Opt-in only. Preview/staging stay noindex without this.
# Never set true on preview. Set only on the intended public production host
# after an explicit launch decision.
ITT_ALLOW_INDEXING=false
# Legacy alias accepted by the indexer; prefer ITT_ALLOW_INDEXING.
CIT_ALLOW_INDEXING=false

# --- Local development ---
# File-store CMS and local admin accounts (admin@itt.local / editor@itt.local).
# Env names keep the inherited CIT_* prefix. Do not set CIT_ADMIN_DEV_PASSWORD on Vercel production.
CIT_ADMIN_DEV_PASSWORD=

# HMAC keys. Production (VERCEL_ENV=production) requires CIT_ADMIN_SESSION_SECRET.
# Preview may use CIT_ADMIN_SESSION_SECRET or CIT_PREVIEW_SECRET; if unset, the
# local password may be used. Known development fallback strings are rejected
# on production and preview.
CIT_ADMIN_SESSION_SECRET=
CIT_PREVIEW_SECRET=

# --- Supabase ---
# Use the publishable/anon key in NEXT_PUBLIC_*.
# Never put the service-role key in NEXT_PUBLIC_* or client code.
# Preview and production SHOULD use separate Supabase projects when available.
# If they temporarily share a project, they MUST still use separate signing secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias used by some Supabase SSR examples
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required for conference event persistence (Махни досадното) on preview/production.
SUPABASE_SERVICE_ROLE_KEY=

# Local people fixtures only. Never set on production.
CIT_DEV_FIXTURES=

# Contact form (Resend). Production needs RESEND_API_KEY.
# Enquiries are delivered to CONTACT_TO_EMAIL. From must be a verified domain
# on Resend (not a Gmail address). Reply-To stays on the Gmail inbox.
CONTACT_TO_EMAIL=i.t.todorov83@gmail.com
CONTACT_FROM_EMAIL=ITT Digital Hub <noreply@mail.ittdigitalhub.uk>
RESEND_API_KEY=

# --- AI Act assistant (server-only; never NEXT_PUBLIC_*) ---
# Provider is replaceable infrastructure. The product is the AI Act assistant.
# Hosted assistant. Keys stay server-side. Never NEXT_PUBLIC_*.
# Canonical Google key: GOOGLE_AI_API_KEY. GEMINI_API_KEY is accepted as a legacy alias.
AI_PROVIDER=google
AI_MODEL=gemini-3.8-flash
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Settlement Analyzer / Анализатор на населени места ---
# Optional. Enables owner/admin cookie access to skip the registration gate.
# Generate a long random value. Never expose it to the client bundle.
LAND_SCOPE_ADMIN_KEY=
# Optional privacy labels shown on the analyzer privacy page.
LAND_SCOPE_DATA_CONTROLLER_NAME=ITT Digital Hub
LAND_SCOPE_PRIVACY_CONTACT_EMAIL=office@ittdigitalhub.org
LAND_SCOPE_DATA_RETENTION_MONTHS=24

# Public Agent Gateway used by the AI Act assistant UI. Override for a local Worker.
NEXT_PUBLIC_AGENT_GATEWAY_ORIGIN=https://api.ittdigitalhub.org

# --- ITT Agent Platform (local hub and Cloudflare gateway) ---
# The website does not call a model. The local Agent Hub does.
# OpenRouter is the AI Act primary. Put OPENROUTER_API_KEY only in platform/agent-hub/.env.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=z-ai/glm-5.3-flash
# OPENROUTER_SITE_URL=https://ittdigitalhub.org
# OPENROUTER_APP_NAME=ITT Digital Hub
# Copy the example files and replace the placeholder secret before opening the tunnel.
# The hub also reads missing keys from .env.local (Google, Supabase, Resend) and does not override
# variables already set in the shell or in platform/agent-hub/.env.
#   platform/agent-hub/.env.example -> platform/agent-hub/.env
#   platform/gateway/.dev.vars.example -> platform/gateway/.dev.vars
# GOOGLE_AI_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# --- ViK Projektant V2 (server-only; never NEXT_PUBLIC_*) ---
# One model id for both sides of the comparison. Do not set a separate control or expert model.
VIK_COMPARISON_MODEL=gpt-5.6
# Public MCP URL that OpenAI can reach. Defaults to ${NEXT_PUBLIC_SITE_URL}/api/mcp/vik.
# VIK_MCP_PUBLIC_URL=https://ittdigitalhub.org/api/mcp/vik
# HTTPS destination of the published ITT Digital Hub plugin. Leave empty until ChatGPT publishes it.
# VIK_CHATGPT_DESTINATION_URL=
# Local MCP process port.
# VIK_MCP_PORT=8789
